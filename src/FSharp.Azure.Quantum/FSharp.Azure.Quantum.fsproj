    <!-- Unified Quantum Arithmetic (state-based, works with IQuantumBackend) -->
    <!-- ✅ Migration Complete: All modular arithmetic functions implemented (Dec 11, 2024) -->
    <!-- Must come before Shor.fs: Shor's controlledModularMultiplication calls Arithmetic module.
         Must ALSO come before QPE.fs, so QPE can lower a ModularExponentiation unitary to the
         Beauregard circuit instead of refusing it and pointing callers at Shor. That lowering is
         what lets any backend — gate or braid — execute Shor's period finding through the one
         unified path. This file references neither QFT nor QPE, so the move is a pure reorder. -->
    <Compile Include="Algorithms\QuantumArithmetic.fs" />

    <!-- State preparation must precede QPE: custom eigenvector prep uses Mottonen -->
    <Compile Include="Algorithms\MottonenStatePreparation.fs" />
    <Compile Include="Algorithms\QPE.fs" />

    <Compile Include="Algorithms\Shor.fs" />
    <Compile Include="Algorithms\TrotterSuzuki.fs" />

