         Depends on TrotterSuzuki (PauliHamiltonian) for observe. -->
    <Compile Include="Core\Primitives.fs" />

    <!-- ADAPT-VQE / ADAPT-QAOA adaptive ansatz (depends on Primitives, TrotterSuzuki, QaoaOptimizer) -->
    <Compile Include="Algorithms\AdaptVqe.fs" />
    <Compile Include="Algorithms\AdaptQaoa.fs" />

    <!-- Emulate-target mode (transpile→validate→local-run); depends on Primitives, GateTranspiler, CircuitValidator, LocalBackend -->
    <Compile Include="Core\Emulation.fs" />

    <!-- Neutral-atom (Rydberg) analog mode: Trotterizes an analog program to gates (depends on Primitives) -->
    <Compile Include="Algorithms\NeutralAtom.fs" />

