<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateProgramFile>false</GenerateProgramFile>

    <!-- Package Metadata -->
    <Version>0.4.15</Version>
    <PackageId>FSharp.Azure.Quantum.Braket</PackageId>
    <Title>FSharp.Azure.Quantum.Braket</Title>
    <Description>AWS Braket plugin for FSharp.Azure.Quantum. Submits circuits to Braket gate QPUs (IonQ, Rigetti, IQM, OQC, Infleqtion) and simulators (SV1/DM1/TN1) via OpenQASM 3.0, and neutral-atom analog programs to QuEra Aquila via the Braket AHS format. This is the only package that depends on the AWS SDK — the core FSharp.Azure.Quantum package stays AWS-free. Requires FSharp.Azure.Quantum.</Description>
    <Summary>AWS Braket plugin — gate QPUs (IonQ/Rigetti/IQM/OQC/Infleqtion) via OpenQASM 3.0 and QuEra neutral-atom analog via AHS, isolating the AWS SDK dependency from the core package.</Summary>

    <Authors>Tuomas Hietanen</Authors>
    <PackageTags>F#;FSharp;Quantum;AWS;Braket;QuEra;OQC;Infleqtion;NeutralAtom</PackageTags>
    <PackageReleaseNotes>v0.4.15: Rebuilt against FSharp.Azure.Quantum v1.4.15
- CHANGED: Braket results carry their recorded counts, so measuring a returned state yields Braket's own shots rather than outcomes resampled from its amplitudes

v0.4.14: Rebuilt against FSharp.Azure.Quantum v1.4.14
- ADDED: the Braket backend implements IShotSamplingBackend, so sampled UCCSD-VQE knows its shot count
- CHANGED: circuits are transpiled to the target device's gate set before OpenQASM 3.0 export, so composite gates (Toffoli, multi-controlled, controlled-phase) reach the device; an optional JobBudget limits submitted jobs
- Requires FSharp.Azure.Quantum v1.4.14+
</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <Copyright>Unlicense - Public Domain</Copyright>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
	<PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj">
      <PrivateAssets>none</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="..\..\docs\images\logo.png" Pack="true" PackagePath="/" />

    <!-- The AWS SDK dependency lives ONLY in this plugin package. -->
    <PackageReference Include="AWSSDK.Braket" Version="4.0.*" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Braket.fs" />
    <Compile Include="BraketBackend.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
  </ItemGroup>

</Project>
