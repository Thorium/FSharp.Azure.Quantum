<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateProgramFile>false</GenerateProgramFile>

    <!-- Package Metadata -->
    <Version>0.4.16</Version>
    <PackageId>FSharp.Azure.Quantum.Topological</PackageId>
    <Title>FSharp.Azure.Quantum.Topological</Title>
    <Description>Topological quantum computing plugin for FSharp.Azure.Quantum. Provides anyon theory (Ising/Fibonacci/SU(2)_k), braiding compilation, gate-to-braid conversion, Majorana (tetron) hardware device profiles and noise models, and topological file format (.tqp). Includes Majorana 1 (Al–InAs) and Majorana 2 (InAs–Pb) hardware profiles. Seamlessly integrates with main package algorithms (Grover, QFT, QAOA) via IQuantumBackend interface. Requires FSharp.Azure.Quantum v1.3.10+.</Description>
    <Summary>F# topological quantum computing plugin with anyon models, braiding compilation, Majorana hardware profiles, noise models, and seamless integration with FSharp.Azure.Quantum algorithms</Summary>
    <PackageReleaseNotes>v0.4.16: Rebuilt against FSharp.Azure.Quantum v1.4.16
- ADDED: quantum Monte Carlo, option pricing and the risk engine run on the topological backend: amplitude estimation reads its logical-qubit probabilities

v0.4.14: magic-state T injection applies T; rejected distillation batches stay rejected
- CHANGED (breaking type): MagicStateDistillation.applyTGate returned the data qubit unrotated. The new applyTGateToQubit applies the exact T through TopologicalOperations.tGate, and applyTGate calls it; TGateResult.OutputState is now a TopologicalOperations.Superposition, since a single fusion tree cannot hold the T phase. GateFidelity still carries the magic state's fidelity
- CHANGED: distill15to1 returned an improved state even when the syndrome check rejected the batch. DistillationResult gains Accepted, and a rejected batch keeps the input fidelity. distillIterative keeps only accepted batches, ignores partial batches and returns an Error when too few pass; supply several times 15^rounds states for a reliable run
- Requires FSharp.Azure.Quantum v1.4.14+
</PackageReleaseNotes>

    <!-- Repository Info -->
    <RepositoryUrl>https://github.com/thorium/FSharp.Azure.Quantum</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/thorium/FSharp.Azure.Quantum</PackageProjectUrl>

    <!-- Author & License -->
    <Authors>Tuomas Hietanen</Authors>
    <PackageTags>F#;FSharp;Quantum;Topological;Anyon;Majorana;Fibonacci;Ising;TQFT;Braiding;Azure</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <Copyright>Unlicense - Public Domain</Copyright>

    <!-- Symbols -->
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IncludeSymbols>true</IncludeSymbols>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
	<PackageIcon>logo.png</PackageIcon>

  </PropertyGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <!-- Use ProjectReference for development and building -->
    <!-- When packing, this will be converted to PackageReference automatically -->
    <ProjectReference Include="..\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj">
      <!-- This ensures the dependency is properly referenced in the .nupkg -->
      <PrivateAssets>none</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="..\..\docs\images\logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TopologicalError.fs" />
    <Compile Include="AnyonSpecies.fs" />
    <Compile Include="FusionRules.fs" />
    <Compile Include="TopologicalHelpers.fs" />
    <Compile Include="FMatrix.fs" />
    <Compile Include="BraidingOperators.fs" />
    <Compile Include="FusionTree.fs" />
    <Compile Include="TopologicalOperations.fs" />
    <Compile Include="ModularData.fs" />
    <Compile Include="RMatrix.fs" />
    <Compile Include="BraidingConsistency.fs" />
    <Compile Include="BraidGroup.fs" />
    <Compile Include="KauffmanBracket.fs" />
    <Compile Include="KnotConstructors.fs" />
    <Compile Include="BraidToGate.fs" />
    <Compile Include="SolovayKitaev.fs" />
    <Compile Include="CircuitOptimization.fs" />
    <Compile Include="ErrorPropagation.fs" />
    <Compile Include="GateToBraid.fs" />
    <Compile Include="ToricCode.fs" />
    <Compile Include="SurfaceCode.fs" />
    <Compile Include="AnyonicErrorCorrection.fs" />
    <Compile Include="EntanglementEntropy.fs" />
    <Compile Include="TopologicalBackend.fs" />
    <Compile Include="AlgorithmExtensions.fs" />

    <Compile Include="TopologicalBuilder.fs" />
    <Compile Include="TopologicalFormat.fs" />
    <Compile Include="MagicStateDistillation.fs" />
    <Compile Include="DeviceProfile.fs" />
    <Compile Include="NoiseModels.fs" />
    <Compile Include="Visualization.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302" />
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.31.0.145097" />
  </ItemGroup>

</Project>
