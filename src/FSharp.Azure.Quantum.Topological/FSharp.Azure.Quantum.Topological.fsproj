      <!-- This ensures the dependency is properly referenced in the .nupkg -->
      <PrivateAssets>none</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
		<None Include="..\..\docs\images\logo.png" Pack="true" PackagePath="/" />
  </ItemGroup>

