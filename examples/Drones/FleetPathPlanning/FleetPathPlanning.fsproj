<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FSharp.Azure.Quantum.Examples.Drones.FleetPathPlanning</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\_common\Cli.fs" Link="_common\Cli.fs" />
    <Compile Include="..\..\_common\Data.fs" Link="_common\Data.fs" />
    <Compile Include="..\..\_common\Reporting.fs" Link="_common\Reporting.fs" />
    <Compile Include="..\_common\DroneDomain.fs" Link="_common\DroneDomain.fs" />
    <Compile Include="..\_common\PermissionEvidence.fs" Link="_common\PermissionEvidence.fs" />
    <Compile Include="..\_common\MavlinkMission.fs" Link="_common\MavlinkMission.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj" Condition="Exists('..\..\..\src\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj')" />
  </ItemGroup>
  <!-- Copied out of the repository the sources above are missing, so use the NuGet packages. -->
  <ItemGroup Condition="!Exists('..\..\..\src\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj')">
    <PackageReference Include="FSharp.Azure.Quantum" Version="*" />
  </ItemGroup>

</Project>
