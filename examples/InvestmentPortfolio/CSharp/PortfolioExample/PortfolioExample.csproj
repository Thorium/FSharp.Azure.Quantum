<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj" Condition="Exists('..\..\..\..\src\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302" />
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.31.0.145097" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <_SkipUpgradeNetAnalyzersNuGetWarning>true</_SkipUpgradeNetAnalyzersNuGetWarning>
  </PropertyGroup>

  <!-- Bundled market figures (see ../../data/README.md), read from the output folder. -->
  <ItemGroup>
    <None Include="..\..\data\market-stats-2019-2023.json" Link="data\market-stats-2019-2023.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copied out of the repository the sources above are missing, so use the NuGet packages. -->
  <ItemGroup Condition="!Exists('..\..\..\..\src\FSharp.Azure.Quantum\FSharp.Azure.Quantum.fsproj')">
    <PackageReference Include="FSharp.Azure.Quantum" Version="*" />
  </ItemGroup>

</Project>
